@model Desafio.ViewModels.ProdutoIndexViewModel

@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Produtos</h1>

    <a asp-action="Create" class="btn btn-primary">
        Cadastrar produto
    </a>
</div>

@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-6">
        <label for="busca" class="form-label">
            Buscar por nome
        </label>

        <input type="search"
               id="busca"
               name="busca"
               value="@Model.Busca"
               class="form-control"
               placeholder="Digite parte do nome do produto" />
    </div>

    <div class="col-md-4">
        <label asp-for="Ordenacao" class="form-label">
            Ordenar por
        </label>

        <select asp-for="Ordenacao" class="form-select">
            <option value="nome_asc">Nome — A até Z</option>
            <option value="nome_desc">Nome — Z até A</option>
            <option value="preco_asc">Preço — menor para maior</option>
            <option value="preco_desc">Preço — maior para menor</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Aplicar
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Busca)
            || Model.Ordenacao != "nome_asc")
        {
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Limpar
            </a>
        }
    </div>
</form>

<p class="text-muted">
    @Model.TotalProdutos
    @(Model.TotalProdutos == 1
        ? "produto encontrado"
        : "produtos encontrados")
</p>

@if (!Model.Produtos.Any())
{
    if (!string.IsNullOrWhiteSpace(Model.Busca))
    {
        <div class="alert alert-info">
            Nenhum produto foi encontrado para a busca
            "<strong>@Model.Busca</strong>".
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Nenhum produto foi cadastrado.
        </div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Preço</th>
                    <th>Data de cadastro</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var produto in Model.Produtos)
                {
                    <tr>
                        <td>@produto.Nome</td>
                        <td>@produto.Descricao</td>
                        <td>@produto.Preco.ToString("C")</td>
                        <td>
                            @produto.DataCadastro.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@produto.Id"
                               class="btn btn-sm btn-outline-info">
                                Detalhes
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@produto.Id"
                               class="btn btn-sm btn-outline-warning">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@produto.Id"
                               class="btn btn-sm btn-outline-danger">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Navegação entre páginas">
        <ul class="pagination justify-content-center">
            @if (Model.TemPaginaAnterior)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-ordenacao="@Model.Ordenacao"
                       asp-route-pagina="@(Model.PaginaAtual - 1)">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            @for (var numeroPagina = 1;
                numeroPagina <= Model.TotalPaginas;
                numeroPagina++)
            {
                <li class="page-item
                    @(numeroPagina == Model.PaginaAtual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-ordenacao="@Model.Ordenacao"
                       asp-route-pagina="@numeroPagina">
                        @numeroPagina
                    </a>
                </li>
            }

            @if (Model.TemProximaPagina)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-ordenacao="@Model.Ordenacao"
                       asp-route-pagina="@(Model.PaginaAtual + 1)">
                        Próxima
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Próxima</span>
                </li>
            }
        </ul>
    </nav>
}
